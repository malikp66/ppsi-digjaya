{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next-themes": ["./src/lib/stubs/next-themes"],
      "next-intl": ["./src/lib/stubs/next-intl"],
      "next-intl/server": ["./src/lib/stubs/next-intl-server"],
      "react-hook-form": ["./src/lib/stubs/react-hook-form"],
      "@hookform/resolvers/zod": [
        "./src/lib/stubs/hookform-resolvers-zod"
      ],
      "zod": ["./src/lib/stubs/zod"],
      "zustand": ["./src/lib/stubs/zustand"],
      "next-pwa": ["./src/lib/stubs/next-pwa"],
      "qrcode": ["./src/lib/stubs/qrcode"],
      "recharts": ["./src/lib/stubs/recharts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
